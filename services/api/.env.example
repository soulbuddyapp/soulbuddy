APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DEEPSEEK_API_KEY=
GOAL_GUIDANCE_BASE_URL=https://api.deepseek.com
GOAL_GUIDANCE_MODEL=deepseek-chat

POWERSYNC_JWT_ISSUER="${APP_URL}"
POWERSYNC_JWT_AUDIENCE=
POWERSYNC_JWT_SECRET=
POWERSYNC_JWT_KID=
POWERSYNC_JWT_TTL_SECONDS=600

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DEEPGRAM_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=soul_buddy_bot
TELEGRAM_WEBHOOK_SECRET=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_ENCODING=mp3
DEEPGRAM_TTS_BIT_RATE=32000
PRAYER_NARRATION_DISCLOSURE_VERSION=deepgram-aura2-1

# ChatGPT MCP OAuth resource server (configure an external OAuth 2.1/OIDC provider)
# The OAuth provider must support PKCE S256 and register ChatGPT as a client.
CHATGPT_OAUTH_ISSUER=
CHATGPT_OAUTH_AUDIENCE=https://sbuddy.elbiblio.com/mcp
CHATGPT_OAUTH_JWKS_URL=
CHATGPT_OAUTH_INTROSPECTION_URL=
CHATGPT_OAUTH_INTROSPECTION_CLIENT_ID=
CHATGPT_OAUTH_INTROSPECTION_CLIENT_SECRET=
CHATGPT_OAUTH_ACCOUNT_MANAGEMENT_URL=
CHATGPT_OAUTH_EMAIL_CLAIM=https://soulbuddy.app/email
CHATGPT_OAUTH_VERIFIED_CLAIM=https://soulbuddy.app/email_verified
